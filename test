
import React, { useState } from "react";

import AppLayout from "./components/layout/AppLayout";

import Dashboard from "./pages/Dashboard";
import MoldRegister from "./pages/MoldRegister";

// These pages will be connected as we implement each module.
// import TrialManagement from "./pages/TrialManagement";
// import DepartmentTasks from "./pages/DepartmentTasks";
// import Reports from "./pages/Reports";
// import UsersRoles from "./pages/UsersRoles";
// import MasterSettings from "./pages/MasterSettings";

export default function App() {
  const [activePage, setActivePage] = useState("dashboard");

  const handleNavigate = (page) => {
    setActivePage(page);
  };

  const renderPage = () => {
    switch (activePage) {
      case "dashboard":
        return <Dashboard onNavigate={handleNavigate} />;

      case "molds":
        return <MoldRegister />;

      // case "trials":
      //   return <TrialManagement />;

      // case "tasks":
      //   return <DepartmentTasks />;

      // case "reports":
      //   return <Reports />;

      // case "users":
      //   return <UsersRoles />;

      // case "settings":
      //   return <MasterSettings />;

      default:
        return <Dashboard onNavigate={handleNavigate} />;
    }
  };

  return (
    <AppLayout
      activePage={activePage}
      onNavigate={handleNavigate}
    >
      {renderPage()}
    </AppLayout>
  );
}
