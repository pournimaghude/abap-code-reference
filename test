4. Update App.jsx
Your work: Open frontend/src/App.jsx and replace its code with this version.

This adds selected-mold tracking and a route for the details page.

import React, { useState } from "react";

import AppLayout from "./components/layout/AppLayout";

import Dashboard from "./pages/Dashboard";
import MoldRegister from "./pages/MoldRegister";
import MoldDetailsPage from "./pages/MoldDetailsPage";

export default function App() {
  const [activePage, setActivePage] = useState("dashboard");
  const [selectedMold, setSelectedMold] = useState(null);

  const handleNavigate = (page) => {
    setActivePage(page);
  };

  const handleViewMold = (mold) => {
    setSelectedMold(mold);
    setActivePage("mold-details");
  };

  const handleBackToMolds = () => {
    setActivePage("molds");
  };

  const renderPage = () => {
    switch (activePage) {
      case "dashboard":
        return <Dashboard onNavigate={handleNavigate} />;

      case "molds":
        return <MoldRegister onViewMold={handleViewMold} />;

      case "mold-details":
        return (
          <MoldDetailsPage
            mold={selectedMold}
            onBack={handleBackToMolds}
          />
        );

      default:
        return <Dashboard onNavigate={handleNavigate} />;
    }
  };

  return (
    <AppLayout
      activePage={activePage}
      onNavigate={handleNavigate}
    >
      {renderPage()}
    </AppLayout>
  );
}



Important: This code imports MoldDetailsPage.jsx, so that file must have a valid default-exported React component. We'll create it in the next step before you run the application.
