import React from "react";

export default function MoldDetailsPage({ mold, onBack }) {
  if (!mold) {
    return (
      <div className="mold-details-page">
        <button className="mold-btn-secondary" onClick={onBack}>
          Back to Mold Register
        </button>
        <p>No mold selected.</p>
      </div>
    );
  }

  const details = [
    ["Mold Number", mold.moldNo],
    ["Customer", mold.customer],
    ["Model", mold.model],
    ["Group", mold.group || "-"],
    ["Count", mold.count],
    ["Subsidiary", mold.subsidiary || "-"],
    ["Status", mold.status],
  ];

  return (
    <div className="mold-details-page">
      <div className="mold-details-page-heading">
        <div>
          <button className="mold-back-button" onClick={onBack}>
            ← Back to Mold Register
          </button>

          <h2>{mold.moldNo}</h2>
          <p>Complete mold information and lifecycle history.</p>
        </div>

        <span
          className={`mold-status ${mold.status
            .toLowerCase()
            .replaceAll(" ", "-")}`}
        >
          {mold.status}
        </span>
      </div>

      <section className="mold-details-section">
        <h3>Basic Information</h3>

        <div className="mold-details-grid">
          {details.map(([label, value]) => (
            <div key={label}>
              <span>{label}</span>
              <strong>{value}</strong>
            </div>
          ))}
        </div>
      </section>

      <section className="mold-details-section">
        <h3>Mold Lifecycle</h3>

        <div className="mold-history-placeholder">
          <div className="mold-history-icon">01</div>
          <div>
            <strong>Trial History</strong>
            <p>Trial records will be displayed here.</p>
          </div>
        </div>

        <div className="mold-history-placeholder">
          <div className="mold-history-icon">02</div>
          <div>
            <strong>Customer Feedback</strong>
            <p>Customer feedback cycles will be displayed here.</p>
          </div>
        </div>

        <div className="mold-history-placeholder">
          <div className="mold-history-icon">03</div>
          <div>
            <strong>Department Work History</strong>
            <p>Department assignments and completion dates will be displayed here.</p>
          </div>
        </div>

        <div className="mold-history-placeholder">
          <div className="mold-history-icon">04</div>
          <div>
            <strong>Mold Movement History</strong>
            <p>Mold handovers and movement records will be displayed here.</p>
          </div>
        </div>
      </section>
    </div>
  );
}



