/* Mold Register row actions */

.mold-row-actions {
  display: flex;
  align-items: center;
  gap: 8px;
}

.mold-action-view,
.mold-action-edit {
  border: 1px solid #dce3ec;
  border-radius: 5px;
  padding: 6px 10px;
  background: #fff;
  font-size: 11px;
  font-weight: 600;
  cursor: pointer;
}

.mold-action-view {
  color: #087f8c;
}

.mold-action-edit {
  color: #2563eb;
}

.mold-action-view:hover {
  background: #e8f7f7;
  border-color: #159c9b;
}

.mold-action-edit:hover {
  background: #eff6ff;
  border-color: #2563eb;
}

/* Mold details modal */

.mold-details-modal {
  max-width: 650px;
}

.mold-details-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 15px;
}

.mold-details-grid > div {
  display: flex;
  flex-direction: column;
  gap: 7px;
  padding: 14px;
  border: 1px solid #edf1f5;
  border-radius: 8px;
  background: #f9fbfd;
}

.mold-details-grid span {
  color: #8492a6;
  font-size: 11px;
}

.mold-details-grid strong {
  color: #172b4d;
  font-size: 13px;
}

@media (max-width: 600px) {
  .mold-details-grid {
    grid-template-columns: 1fr;
  }
}



