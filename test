import React, { useState } from "react";

const tabs = [
  "Overview",
  "Trial History",
  "Customer Feedback",
  "Department Tasks",
  "Movement History",
];

export default function MoldDetailsPage({ mold, onBack }) {
  const [activeTab, setActiveTab] = useState("Overview");

  if (!mold) {
    return (
      <div className="mold-details-page">
        <button className="mold-back-button" onClick={onBack}>
          ← Back to Mold Register
        </button>
        <div className="mold-details-empty">
          <h3>No mold selected</h3>
          <p>Please select a mold from the Mold Register.</p>
        </div>
      </div>
    );
  }

  const overviewItems = [
    ["Mold Number", mold.moldNo],
    ["Customer", mold.customer],
    ["Model", mold.model],
    ["Group", mold.group || "-"],
    ["Count", mold.count ?? "-"],
    ["Subsidiary", mold.subsidiary || "-"],
    ["Status", mold.status || "-"],
  ];

  const renderTabContent = () => {
    switch (activeTab) {
      case "Overview":
        return (
          <div className="mold-overview-section">
            <div className="mold-details-section-heading">
              <div>
                <h3>Basic Mold Information</h3>
                <p>General information about this registered mold.</p>
              </div>
            </div>

            <div className="mold-details-info-grid">
              {overviewItems.map(([label, value]) => (
                <div className="mold-details-info-card" key={label}>
                  <span>{label}</span>
                  <strong>{value}</strong>
                </div>
              ))}
            </div>
          </div>
        );

      case "Trial History":
        return (
          <div className="mold-history-placeholder">
            <div className="mold-placeholder-icon">01</div>
            <h3>Trial History</h3>
            <p>
              All trials for this mold will appear here, including T1, T2,
              T3 and later trials, with trial dates, results and remarks.
            </p>
            <span>Trial history module — to be implemented</span>
          </div>
        );

      case "Customer Feedback":
        return (
          <div className="mold-history-placeholder">
            <div className="mold-placeholder-icon">02</div>
            <h3>Customer Feedback History</h3>
            <p>
              Customer feedback, received dates, molding decisions and
              modification cycles will be recorded here.
            </p>
            <span>Feedback history module — to be implemented</span>
          </div>
        );

      case "Department Tasks":
        return (
          <div className="mold-history-placeholder">
            <div className="mold-placeholder-icon">03</div>
            <h3>Department Work History</h3>
            <p>
              Assigned departments, task dates, completion status, remarks
              and time taken by each department will appear here.
            </p>
            <span>Department task module — to be implemented</span>
          </div>
        );

      case "Movement History":
        return (
          <div className="mold-history-placeholder">
            <div className="mold-placeholder-icon">04</div>
            <h3>Mold Movement History</h3>
            <p>
              The complete movement and handover history of this mold
              between Molding and other departments will appear here.
            </p>
            <span>Movement history module — to be implemented</span>
          </div>
        );

      default:
        return null;
    }
  };

  return (
    <div className="mold-details-page">
      <div className="mold-details-topbar">
        <button className="mold-back-button" onClick={onBack}>
          ← Back to Mold Register
        </button>

        <span className="mold-details-breadcrumb">
          Mold Register / Mold Details
        </span>
      </div>

      <div className="mold-details-title">
        <div>
          <span className="mold-details-eyebrow">MOLD INFORMATION</span>
          <h2>{mold.moldNo}</h2>
          <p>
            {mold.customer} · {mold.model}
          </p>
        </div>

        <span
          className={`mold-status ${String(mold.status || "")
            .toLowerCase()
            .replaceAll(" ", "-")}`}
        >
          {mold.status || "Unknown"}
        </span>
      </div>

      <div className="mold-details-tabs">
        {tabs.map((tab) => (
          <button
            key={tab}
            className={
              activeTab === tab
                ? "mold-details-tab active"
                : "mold-details-tab"
            }
            onClick={() => setActiveTab(tab)}
          >
            {tab}
          </button>
        ))}
      </div>

      <section className="mold-details-content">
        {renderTabContent()}
      </section>
    </div>
  );
}



3. Update src/App.jsx
This step is essential. App.jsx controls which page appears. It remembers which mold you selected and passes that mold to MoldDetailsPage.

Replace your current App.jsx with:

import React, { useState } from "react";

import AppLayout from "./components/layout/AppLayout";

import Dashboard from "./pages/Dashboard";
import MoldRegister from "./pages/MoldRegister";
import MoldDetailsPage from "./pages/MoldDetailsPage";

export default function App() {
  const [activePage, setActivePage] = useState("dashboard");
  const [selectedMold, setSelectedMold] = useState(null);

  const handleNavigate = (page) => {
    setActivePage(page);
  };

  const handleViewMold = (mold) => {
    setSelectedMold(mold);
    setActivePage("mold-details");
  };

  const renderPage = () => {
    switch (activePage) {
      case "dashboard":
        return <Dashboard onNavigate={handleNavigate} />;

      case "molds":
        return <MoldRegister onViewMold={handleViewMold} />;

      case "mold-details":
        return (
          <MoldDetailsPage
            mold={selectedMold}
            onBack={() => setActivePage("molds")}
          />
        );

      default:
        return <Dashboard onNavigate={handleNavigate} />;
    }
  };

  return (
    <AppLayout
      activePage={activePage}
      onNavigate={handleNavigate}
    >
      {renderPage()}
    </AppLayout>
  );
}



