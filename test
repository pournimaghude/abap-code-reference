import React, { useMemo, useState } from "react";
import { moldActivityHistory } from "../data/mockData";

const tabs = [
  "Overview",
  "Trial History",
  "Customer Feedback",
  "Department Tasks",
  "Movement History",
];

function formatDate(dateString) {
  const [year, month, day] = dateString.split("-").map(Number);

  return new Date(year, month - 1, day).toLocaleDateString("en-IN", {
    day: "2-digit",
    month: "short",
    year: "numeric",
  });
}

function getCalendarDays(startDate, endDate) {
  const start = new Date(`${startDate}T00:00:00`);
  const end = new Date(`${endDate}T00:00:00`);

  return Math.round((end - start) / (1000 * 60 * 60 * 24));
}

export default function MoldDetailsPage({ mold, onBack }) {
  const [activeTab, setActiveTab] = useState("Overview");

  const activities = useMemo(() => {
    if (!mold) return [];

    return [...(moldActivityHistory[mold.moldNo] || [])].sort(
      (a, b) => a.sequence - b.sequence
    );
  }, [mold]);

  const trialGroups = useMemo(() => {
    const groups = {};

    activities.forEach((activity) => {
      if (!groups[activity.trialNo]) {
        groups[activity.trialNo] = [];
      }

      groups[activity.trialNo].push(activity);
    });

    return Object.entries(groups).map(([trialNo, records]) => ({
      trialNo,
      records,
      startDate: records[0].date,
      endDate: records[records.length - 1].date,
      totalDays: getCalendarDays(
        records[0].date,
        records[records.length - 1].date
      ),
    }));
  }, [activities]);

  if (!mold) {
    return (
      <div className="mold-details-page">
        <button className="mold-back-button" onClick={onBack}>
          ← Back to Mold Register
        </button>

        <div className="mold-details-empty">
          <h3>No mold selected</h3>
          <p>Please select a mold from the Mold Register.</p>
        </div>
      </div>
    );
  }

  const overviewItems = [
    ["Mold Number", mold.moldNo],
    ["Customer", mold.customer],
    ["Model", mold.model],
    ["Group", mold.group || "-"],
    ["Count", mold.count ?? "-"],
    ["Subsidiary", mold.subsidiary || "-"],
    ["Status", mold.status || "-"],
  ];

  const renderTrialHistory = () => {
    if (activities.length === 0) {
      return (
        <div className="mold-history-empty">
          <h3>No trial history available</h3>
          <p>There are no activity records for this mold yet.</p>
        </div>
      );
    }

    return (
      <div className="trial-history-container">
        <div className="trial-history-summary">
          <div>
            <span>Total Activities</span>
            <strong>{activities.length}</strong>
          </div>

          <div>
            <span>Total Trials</span>
            <strong>{trialGroups.length}</strong>
          </div>
        </div>

        {trialGroups.map((trial) => (
          <section className="trial-history-card" key={trial.trialNo}>
            <div className="trial-history-heading">
              <div>
                <span className="trial-history-label">TRIAL CYCLE</span>
                <h3>{trial.trialNo}</h3>
                <p>
                  {formatDate(trial.startDate)} -{" "}
                  {formatDate(trial.endDate)}
                </p>
              </div>

              <div className="trial-duration">
                <strong>{trial.totalDays}</strong>
                <span>Calendar days</span>
              </div>
            </div>

            <div className="trial-activity-list">
              {trial.records.map((activity) => {
                const currentIndex = activities.findIndex(
                  (item) => item.sequence === activity.sequence
                );

                const nextActivity = activities[currentIndex + 1];

                const elapsedDays = nextActivity
                  ? getCalendarDays(activity.date, nextActivity.date)
                  : null;

                return (
                  <div
                    className="trial-activity-item"
                    key={`${mold.moldNo}-${activity.sequence}`}
                  >
                    <div className="trial-activity-marker">
                      <span></span>
                    </div>

                    <div className="trial-activity-content">
                      <div className="trial-activity-top">
                        <span className="trial-activity-number">
                          U{activity.sequence}
                        </span>

                        <span className="trial-activity-date">
                          {formatDate(activity.date)}
                        </span>
                      </div>

                      <h4>{activity.department}</h4>

                      <p>{activity.activity}</p>

                      {nextActivity && (
                        <span className="trial-elapsed-time">
                          {elapsedDays} calendar{" "}
                          {elapsedDays === 1 ? "day" : "days"} until next
                          recorded activity ({nextActivity.department})
                        </span>
                      )}
                    </div>
                  </div>
                );
              })}
            </div>
          </section>
        ))}

        <div className="trial-history-note">
          <strong>Duration calculation:</strong>
          <p>
            Trial cycle duration is calculated from its first recorded
            activity to its last recorded activity. The elapsed time shown
            below each activity is the time until the next recorded event.
            Neither measurement alone confirms actual department processing
            time.
          </p>
        </div>
      </div>
    );
  };

  const renderTabContent = () => {
    switch (activeTab) {
      case "Overview":
        return (
          <div className="mold-overview-section">
            <div className="mold-details-section-heading">
              <div>
                <h3>Basic Mold Information</h3>
                <p>General information about this registered mold.</p>
              </div>
            </div>

            <div className="mold-details-info-grid">
              {overviewItems.map(([label, value]) => (
                <div className="mold-details-info-card" key={label}>
                  <span>{label}</span>
                  <strong>{value}</strong>
                </div>
              ))}
            </div>
          </div>
        );

      case "Trial History":
        return renderTrialHistory();

      case "Customer Feedback":
        return (
          <div className="mold-history-placeholder">
            <div className="mold-placeholder-icon">02</div>
            <h3>Customer Feedback History</h3>
            <p>
              Customer feedback, received dates, molding decisions and
              modification cycles will appear here.
            </p>
            <span>Feedback history module - to be implemented</span>
          </div>
        );

      case "Department Tasks":
        return (
          <div className="mold-history-placeholder">
            <div className="mold-placeholder-icon">03</div>
            <h3>Department Work History</h3>
            <p>
              Assigned departments, task dates, completion status, remarks
              and time taken by each department will appear here.
            </p>
            <span>Department task module - to be implemented</span>
          </div>
        );

      case "Movement History":
        return (
          <div className="mold-history-placeholder">
            <div className="mold-placeholder-icon">04</div>
            <h3>Mold Movement History</h3>
            <p>
              The complete movement and handover history of this mold
              between Molding and other departments will appear here.
            </p>
            <span>Movement history module - to be implemented</span>
          </div>
        );

      default:
        return null;
    }
  };

  return (
    <div className="mold-details-page">
      <div className="mold-details-topbar">
        <button className="mold-back-button" onClick={onBack}>
          ← Back to Mold Register
        </button>

        <span className="mold-details-breadcrumb">
          Mold Register / Mold Details
        </span>
      </div>

      <div className="mold-details-title">
        <div>
          <span className="mold-details-eyebrow">MOLD INFORMATION</span>
          <h2>{mold.moldNo}</h2>
          <p>
            {mold.customer} · {mold.model}
          </p>
        </div>

        <span
          className={`mold-status ${String(mold.status || "")
            .toLowerCase()
            .replaceAll(" ", "-")}`}
        >
          {mold.status || "Unknown"}
        </span>
      </div>

      <div className="mold-details-tabs">
        {tabs.map((tab) => (
          <button
            key={tab}
            className={
              activeTab === tab
                ? "mold-details-tab active"
                : "mold-details-tab"
            }
            onClick={() => setActiveTab(tab)}
          >
            {tab}
          </button>
        ))}
      </div>

      <section className="mold-details-content">
        {renderTabContent()}
      </section>
    </div>
  );
}



