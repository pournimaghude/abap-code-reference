  height: 6px;
  width: 6px;
  background: currentColor;
  border-radius: 50%;
}

.badge-success { background: var(--success-bg); color: var(--success); }
.badge-warning { background: var(--warning-bg); color: var(--warning); }
.badge-danger { background: var(--danger-bg); color: var(--danger); }
.badge-info { background: var(--info-bg); color: var(--info); }
.badge-neutral { background: #edf0f3; color: #667687; }

/* Search */
.search-bar {
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 0 11px;
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  background: white;
  color: var(--text-secondary);
  min-width: 230px;
}

.search-bar input {
  border: none;
  outline: none;
  padding: 10px 0;
  width: 100%;
  font-size: 12px;
}

.search-bar button,
.icon-button {
  border: 0;
  background: transparent;
  color: var(--text-secondary);
  cursor: pointer;
}

/* Tables */
.data-table-wrapper { width: 100%; overflow-x: auto; }

.data-table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
}

.data-table th {
  font-size: 10px;
  color: var(--text-muted);
  padding: 12px;
  border-bottom: 1px solid var(--border-color);
}

.data-table td {
  font-size: 12px;
  padding: 13px 12px;
  border-bottom: 1px solid #f0f2f5;
}

.clickable-row { cursor: pointer; }
.clickable-row:hover { background: #f8fafb; }

.table-message {
  text-align: center;
  padding: 30px !important;
  color: var(--text-muted);
}

/* Filters and pagination */
.table-filters {
  display: flex;
  gap: 12px;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 17px;
}

.table-filters select { width: auto; min-width: 140px; }

.pagination {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 14px;
  padding: 15px 0;
  font-size: 12px;
}

.pagination button {
  display: flex;
  align-items: center;
  gap: 5px;
  padding: 7px 10px;
  border: 1px solid var(--border-color);
  background: white;
  border-radius: 6px;
}

.pagination button:disabled { opacity: .4; cursor: not-allowed; }

/* Forms */
.form-section {
  background: white;
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: 22px;
  margin-bottom: 17px;
}

.form-section-heading {
  padding-bottom: 15px;
  margin-bottom: 20px;
  border-bottom: 1px solid var(--border-color);
}

.form-section-heading h3 {
  margin: 0;
  font-size: 15px;
}

.form-section-heading p {
  color: var(--text-secondary);
  font-size: 11px;
}

.form-section-content {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
}

.form-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  margin-top: 20px;
}

/* Dashboard */
.stat-card, .panel {
  background: white;
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: 18px;
}

.stat-card-icon {
  width: 38px;
  height: 38px;
  border-radius: 9px;
  display: grid;
  place-items: center;
  background: var(--primary-light);
  color: var(--primary);
}

.stat-card-content p {
  font-size: 12px;
  color: var(--text-secondary);
  margin: 13px 0 5px;
}

.stat-card-content h2 {
  font-size: 25px;
  margin: 0;
}

.stat-card-content small {
  color: var(--text-muted);
  font-size: 10px;
}

.panel-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 17px;
}

.panel-heading h3 { margin: 0; font-size: 15px; }
.panel-heading p { color: var(--text-secondary); font-size: 11px; }

.link-button {
  background: none;
  border: none;
  color: var(--primary);
  cursor: pointer;
  font-size: 12px;
  font-weight: 600;
}

.pending-task {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 13px 0;
  border-bottom: 1px solid var(--border-color);
}

.pending-task > div { flex: 1; min-width: 0; }
.pending-task strong { display: block; font-size: 12px; }
.pending-task small { color: var(--text-muted); font-size: 10px; }

/* Layout */
.sidebar {
  width: var(--sidebar-width);
  min-height: 100vh;
  background: var(--sidebar-bg);
  color: white;
  padding: 22px 15px;
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
}

.sidebar-brand {
  display: flex;
  align-items: center;
  gap: 11px;
  margin-bottom: 25px;
}

.brand-logo {
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  border-radius: 9px;
  background: var(--primary);
}

.sidebar-brand strong { display: block; font-size: 17px; }
.sidebar-brand small { color: #9aabba; font-size: 10px; }

.department-label {
  background: #20384c;
  color: #9eb4c5;
  padding: 10px;
  font-size: 9px;
  letter-spacing: 1px;
  border-radius: 6px;
}

.nav-heading {
  margin: 23px 10px 9px;
  font-size: 9px;
  letter-spacing: 1px;
  color: #8298aa;
  font-weight: 700;
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 12px;
  width: 100%;
  padding: 11px;
  border: 0;
  border-radius: 7px;
  background: transparent;
  color: var(--sidebar-text);
  text-align: left;
  font-size: 12px;
  margin: 3px 0;
}

.nav-item.active {
  background: var(--sidebar-active);
  color: white;
  box-shadow: inset 3px 0 var(--primary);
}

.nav-item:hover { background: var(--sidebar-active); color: white; }

.sidebar-footer {
  margin-top: auto;
  padding: 15px 5px 0;
  font-size: 11px;
  color: #b7c5d0;
  display: flex;
  align-items: center;
  gap: 8px;
}

.online-dot {
  width: 7px;
  height: 7px;
  background: #55b998;
  border-radius: 50%;
}

.app-header {
  height: var(--header-height);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28px;
  background: white;
  border-bottom: 1px solid var(--border-color);
}

.header-search, .header-actions, .header-user {
  display: flex;
  align-items: center;
  gap: 12px;
}

.header-search input {
  border: 0;
  outline: 0;
  width: 230px;
  font-size: 12px;
}

.header-actions { gap: 18px; }
.header-user { font-size: 11px; }
.header-user strong, .header-user small { display: block; }
.header-user small { color: var(--text-secondary); margin-top: 3px; }

.user-avatar {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--primary-light);
  color: var(--primary);
  font-weight: 700;
}

.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24px;
}

.page-header h1 { font-size: 26px; margin: 0; }
.page-subtitle { color: var(--text-secondary); font-size: 12px; }
.page-actions { display: flex; gap: 10px; }
.page-breadcrumb { color: var(--text-muted); font-size: 10px; }

.breadcrumb, .breadcrumb-item {
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: 11px;
  color: var(--text-secondary);
}

.breadcrumb .current { color: var(--text-primary); font-weight: 600; }

/* Modal */
.modal-overlay {
  position: fixed;
  inset: 0;
  z-index: 1000;
  background: rgba(15, 30, 45, .48);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
}

.modal-content {
  background: white;
  width: 100%;
  max-height: 90vh;
  overflow-y: auto;
  border-radius: 12px;
  box-shadow: var(--shadow-md);
}

.modal-small { max-width: 420px; }
.modal-medium { max-width: 650px; }
.modal-large { max-width: 950px; }

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 22px;
  border-bottom: 1px solid var(--border-color);
}

.modal-header h2 { font-size: 16px; margin: 0; }
.modal-body { padding: 22px; }

.confirm-dialog { text-align: center; }
.confirm-dialog p { font-size: 13px; line-height: 1.6; }

/* Empty and loading states */
.loading-state, .empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 45px 20px;
  color: var(--text-secondary);
  text-align: center;
}

.empty-state h3 { color: var(--text-primary); }
.empty-state p { font-size: 12px; }

.spin { animation: spin 1s linear infinite; }

@keyframes spin {
  to { transform: rotate(360deg); }
}

@media (max-width: 768px) {
  .form-section-content { grid-template-columns: 1fr; }
  .page-header { align-items: flex-start; gap: 15px; flex-direction: column; }
  .app-header { padding: 0 14px; }
  .header-search input { width: 120px; }
}



