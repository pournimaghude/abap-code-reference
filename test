}

function statusStyle (status) {
  const colors = {
    'In Progress': { background: '#e0f2fe', color: '#0369a1' },
    Pending: { background: '#fff7ed', color: '#c2410c' },
    Completed: { background: '#dcfce7', color: '#15803d' },
    Active: { background: '#e0e7ff', color: '#4338ca' }
  }

  return {
    ...colors[status],
    padding: '5px 10px',
    borderRadius: '20px',
    fontSize: '12px',
    fontWeight: 600,
    whiteSpace: 'nowrap'
  }
}

