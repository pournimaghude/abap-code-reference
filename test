import React, { useEffect, useState } from "react";

const emptyForm = {
  moldNo: "",
  customer: "",
  model: "",
  group: "",
  count: 1,
  subsidiary: "",
  status: "Active",
};

export default function MoldForm({
  onSave,
  onCancel,
  initialData = null,
}) {
  const [formData, setFormData] = useState(initialData || emptyForm);
  const [error, setError] = useState("");

  useEffect(() => {
    setFormData(initialData || emptyForm);
    setError("");
  }, [initialData]);

  const handleChange = (event) => {
    const { name, value } = event.target;

    setFormData((previous) => ({
      ...previous,
      [name]: name === "count" ? Number(value) : value,
    }));

    setError("");
  };

  const handleSubmit = (event) => {
    event.preventDefault();

    if (
      !formData.moldNo.trim() ||
      !formData.customer.trim() ||
      !formData.model.trim()
    ) {
      setError("Please enter Mold Number, Customer and Model.");
      return;
    }

    if (!Number.isInteger(formData.count) || formData.count < 1) {
      setError("Count must be at least 1.");
      return;
    }

    onSave({
      ...formData,
      moldNo: formData.moldNo.trim(),
      customer: formData.customer.trim(),
      model: formData.model.trim(),
    });
  };

  return (
    <form className="mold-form" onSubmit={handleSubmit}>
      <div className="mold-form-grid">
        <div className="mold-form-field">
          <label>Mold Number *</label>
          <input
            name="moldNo"
            value={formData.moldNo}
            onChange={handleChange}
            placeholder="Example: MOLD-006"
            required
          />
        </div>

        <div className="mold-form-field">
          <label>Customer *</label>
          <input
            name="customer"
            value={formData.customer}
            onChange={handleChange}
            placeholder="Enter customer name"
            required
          />
        </div>

        <div className="mold-form-field">
          <label>Model *</label>
          <input
            name="model"
            value={formData.model}
            onChange={handleChange}
            placeholder="Enter model name"
            required
          />
        </div>

        <div className="mold-form-field">
          <label>Group</label>
          <select
            name="group"
            value={formData.group}
            onChange={handleChange}
          >
            <option value="">Select group</option>
            <option value="Automotive">Automotive</option>
            <option value="Industrial">Industrial</option>
            <option value="Commercial">Commercial</option>
            <option value="Other">Other</option>
          </select>
        </div>

        <div className="mold-form-field">
          <label>Count</label>
          <input
            type="number"
            name="count"
            min="1"
            value={formData.count}
            onChange={handleChange}
          />
        </div>

        <div className="mold-form-field">
          <label>Subsidiary</label>
          <input
            name="subsidiary"
            value={formData.subsidiary}
            onChange={handleChange}
            placeholder="Enter subsidiary"
          />
        </div>

        <div className="mold-form-field">
          <label>Status</label>
          <select
            name="status"
            value={formData.status}
            onChange={handleChange}
          >
            <option value="Active">Active</option>
            <option value="Pending">Pending</option>
            <option value="Under Maintenance">Under Maintenance</option>
            <option value="Completed">Completed</option>
          </select>
        </div>
      </div>

      {error && <p className="mold-form-error">{error}</p>}

      <div className="mold-form-actions">
        <button
          type="button"
          className="mold-btn-secondary"
          onClick={onCancel}
        >
          Cancel
        </button>

        <button type="submit" className="mold-btn-primary">
          {initialData ? "Update Mold" : "Save Mold"}
        </button>
      </div>
    </form>
  );
}



