import React from "react";

const moldStatuses = [
  { name: "Active", count: 186, color: "green" },
  { name: "Under Maintenance", count: 18, color: "orange" },
  { name: "Pending", count: 32, color: "yellow" },
  { name: "Completed", count: 12, color: "blue" },
];

export default function MoldStatusOverview() {
  const total = moldStatuses.reduce((sum, item) => sum + item.count, 0);

  return (
    <section className="dashboard-panel">
      <div className="dashboard-panel-heading">
        <div>
          <h3>Mold Status Overview</h3>
          <p>Current status of registered molds</p>
        </div>
      </div>

      <div className="status-overview-total">
        <strong>{total}</strong>
        <span>Total molds</span>
      </div>

      <div className="status-overview-list">
        {moldStatuses.map((item) => (
          <div className="status-overview-item" key={item.name}>
            <div className="status-overview-label">
              <span className={`status-dot ${item.color}`} />
              <span>{item.name}</span>
              <strong>{item.count}</strong>
            </div>

            <div className="status-progress-track">
              <div
                className={`status-progress-fill ${item.color}`}
                style={{ width: `${(item.count / total) * 100}%` }}
              />
            </div>
          </div>
        ))}
      </div>
    </section>
  );
}



Step 2. Add code to DepartmentPendingChart.jsx
File: src/components/dashboard/DepartmentPendingChart.jsx

import React from "react";

const departments = [
  { name: "Tool Room", pending: 12 },
  { name: "Maintenance", pending: 8 },
  { name: "Quality", pending: 6 },
  { name: "Production", pending: 4 },
  { name: "Design", pending: 2 },
];

export default function DepartmentPendingChart() {
  const maximum = Math.max(...departments.map((item) => item.pending));

  return (
    <section className="dashboard-panel">
      <div className="dashboard-panel-heading">
        <div>
          <h3>Department Pending Overview</h3>
          <p>Open activities by department</p>
        </div>
      </div>

      <div className="department-chart">
        {departments.map((item) => (
          <div className="department-chart-row" key={item.name}>
            <span className="department-chart-name">{item.name}</span>

            <div className="department-chart-track">
              <div
                className="department-chart-fill"
                style={{ width: `${(item.pending / maximum) * 100}%` }}
              />
            </div>

            <strong>{item.pending}</strong>
          </div>
        ))}
      </div>
    </section>
  );
}



Step 3. Add code to TrialLeadTimeChart.jsx
File: src/components/dashboard/TrialLeadTimeChart.jsx

This shows sample lead-time days for trials T2 to T10. Later, we will calculate these from actual feedback and trial dates.

import React from "react";

const trialData = [
  { trial: "T2", days: 18 },
  { trial: "T3", days: 22 },
  { trial: "T4", days: 15 },
  { trial: "T5", days: 27 },
  { trial: "T6", days: 20 },
  { trial: "T7", days: 16 },
  { trial: "T8", days: 24 },
  { trial: "T9", days: 19 },
  { trial: "T10", days: 14 },
];

export default function TrialLeadTimeChart() {
  const maximum = Math.max(...trialData.map((item) => item.days));

  return (
    <section className="dashboard-panel">
      <div className="dashboard-panel-heading">
        <div>
          <h3>Trial Lead Time Comparison</h3>
          <p>Average lead time by trial number</p>
        </div>
        <span className="chart-unit">Days</span>
      </div>

      <div className="trial-chart">
        {trialData.map((item) => (
          <div className="trial-chart-column" key={item.trial}>
            <strong>{item.days}</strong>

            <div className="trial-chart-bar-area">
              <div
                className="trial-chart-bar"
                style={{ height: `${(item.days / maximum) * 100}%` }}
              />
            </div>

            <span>{item.trial}</span>
          </div>
        ))}
      </div>
    </section>
  );
}



