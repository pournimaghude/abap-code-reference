function PlaceholderPage ({ title }) {
  return (
    <div style={styles.panel}>
      <h2 style={styles.heading}>{title}</h2>
      <p style={styles.subtitle}>
        This module will be developed in the next frontend setup step.
      </p>
    </div>
  )
}

export default function App () {
  const [activePage, setActivePage] = useState('dashboard')

  const handleNavigate = page => {
    setActivePage(page)
  }

  return (
    <AppLayout activePage={activePage} onNavigate={handleNavigate}>
      {activePage === 'dashboard' ? (
        <Dashboard />
      ) : activePage === 'molds' ? (
        <MoldRegister />
      ) : (
        <PlaceholderPage title={menuPages[activePage] || 'Page'} />
      )}
    </AppLayout>
  )
}

function statusStyle (status) {
  const colors = {
    'In Progress': { background: '#e0f2fe', color: '#0369a1' },
    Pending: { background: '#fff7ed', color: '#c2410c' },
    Completed: { background: '#dcfce7', color: '#15803d' },
    Active: { background: '#e0e7ff', color: '#4338ca' }
  }

  return {
    ...colors[status],
    padding: '5px 10px',
    borderRadius: '20px',
    fontSize: '12px',
    fontWeight: 600,
    whiteSpace: 'nowrap'
  }
}

