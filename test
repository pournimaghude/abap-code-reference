import React, { useMemo, useState } from "react";

const initialMolds = [
  { id: 1, moldNo: "MOLD-001", customer: "Customer A", model: "Model X", group: "Group A", count: 1, status: "Active" },
  { id: 2, moldNo: "MOLD-002", customer: "Customer B", model: "Model Y", group: "Group B", count: 1, status: "Under Maintenance" },
  { id: 3, moldNo: "MOLD-003", customer: "Customer C", model: "Model Z", group: "Group A", count: 2, status: "Active" },
  { id: 4, moldNo: "MOLD-004", customer: "Customer D", model: "Model P", group: "Group C", count: 1, status: "Inactive" },
  { id: 5, moldNo: "MOLD-005", customer: "Customer E", model: "Model Q", group: "Group B", count: 1, status: "Active" },
];

const emptyForm = {
  moldNo: "",
  customer: "",
  model: "",
  group: "",
  count: "1",
  status: "Active",
};

export default function MoldRegister() {
  const [molds, setMolds] = useState(initialMolds);
  const [search, setSearch] = useState("");
  const [statusFilter, setStatusFilter] = useState("All");
  const [showForm, setShowForm] = useState(false);
  const [selectedMold, setSelectedMold] = useState(null);
  const [form, setForm] = useState(emptyForm);
  const [error, setError] = useState("");

  const filteredMolds = useMemo(() => {
    return molds.filter((mold) => {
      const searchText = search.toLowerCase();

      const matchesSearch =
        mold.moldNo.toLowerCase().includes(searchText) ||
        mold.customer.toLowerCase().includes(searchText) ||
        mold.model.toLowerCase().includes(searchText) ||
        mold.group.toLowerCase().includes(searchText);

      const matchesStatus =
        statusFilter === "All" || mold.status === statusFilter;

      return matchesSearch && matchesStatus;
    });
  }, [molds, search, statusFilter]);

  const updateForm = (event) => {
    const { name, value } = event.target;
    setForm((previous) => ({ ...previous, [name]: value }));
  };

  const handleAddMold = (event) => {
    event.preventDefault();
    setError("");

    if (!form.moldNo.trim() || !form.customer.trim() || !form.model.trim()) {
      setError("Please enter Mold No., Customer and Model.");
      return;
    }

    const duplicate = molds.some(
      (mold) => mold.moldNo.toLowerCase() === form.moldNo.trim().toLowerCase()
    );

    if (duplicate) {
      setError("This Mold No. already exists.");
      return;
    }

    const newMold = {
      id: Date.now(),
      ...form,
      moldNo: form.moldNo.trim(),
      customer: form.customer.trim(),
      model: form.model.trim(),
      group: form.group.trim() || "Not Assigned",
      count: Number(form.count) || 1,
    };

    setMolds((previous) => [newMold, ...previous]);
    setForm(emptyForm);
    setShowForm(false);
  };

  const closeForm = () => {
    setShowForm(false);
    setForm(emptyForm);
    setError("");
  };

  return (
    <div>
      <div style={styles.pageHeader}>
        <div>
          <h2 style={styles.title}>Mold Register</h2>
          <p style={styles.subtitle}>
            Register, search and manage all mold records.
          </p>
        </div>

        <button
          type="button"
          style={styles.primaryButton}
          onClick={() => setShowForm(true)}
        >
          + Add New Mold
        </button>
      </div>

      <div style={styles.summaryGrid}>
        <SummaryCard label="Total Molds" value={molds.length} />
        <SummaryCard
          label="Active Molds"
          value={molds.filter((m) => m.status === "Active").length}
        />
        <SummaryCard
          label="Under Maintenance"
          value={molds.filter((m) => m.status === "Under Maintenance").length}
        />
        <SummaryCard
          label="Inactive Molds"
          value={molds.filter((m) => m.status === "Inactive").length}
        />
      </div>

      <section style={styles.panel}>
        <div style={styles.toolbar}>
          <div>
            <h3 style={styles.panelTitle}>All Mold Records</h3>
            <p style={styles.resultText}>
              Showing {filteredMolds.length} of {molds.length} molds
            </p>
          </div>

          <div style={styles.filters}>
            <input
              type="search"
              placeholder="Search mold, customer, model..."
              value={search}
              onChange={(event) => setSearch(event.target.value)}
              style={styles.search}
            />

            <select
              value={statusFilter}
              onChange={(event) => setStatusFilter(event.target.value)}
              style={styles.select}
            >
              <option value="All">All Status</option>
              <option value="Active">Active</option>
              <option value="Under Maintenance">Under Maintenance</option>
              <option value="Inactive">Inactive</option>
            </select>
          </div>
        </div>

        <div style={{ overflowX: "auto" }}>
          <table style={styles.table}>
            <thead>
              <tr>
                <th style={styles.th}>Mold No.</th>
                <th style={styles.th}>Customer</th>
                <th style={styles.th}>Model</th>
                <th style={styles.th}>Group</th>
                <th style={styles.th}>Count</th>
                <th style={styles.th}>Status</th>
                <th style={styles.th}>Action</th>
              </tr>
            </thead>

            <tbody>
              {filteredMolds.map((mold) => (
                <tr key={mold.id}>
                  <td style={styles.td}>
                    <strong style={{ color: "#078f91" }}>{mold.moldNo}</strong>
                  </td>
                  <td style={styles.td}>{mold.customer}</td>
                  <td style={styles.td}>{mold.model}</td>
                  <td style={styles.td}>{mold.group}</td>
                  <td style={styles.td}>{mold.count}</td>
                  <td style={styles.td}>
                    <StatusBadge status={mold.status} />
                  </td>
                  <td style={styles.td}>
                    <button
                      type="button"
                      style={styles.viewButton}
                      onClick={() => setSelectedMold(mold)}
                    >
                      View Details
                    </button>
                  </td>
                </tr>
              ))}

              {filteredMolds.length === 0 && (
                <tr>
                  <td colSpan="7" style={styles.empty}>
                    No mold records found. Try changing your search or filter.
                  </td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      </section>

      {showForm && (
        <div style={styles.backdrop} onMouseDown={closeForm}>
          <div
            style={styles.modal}
            onMouseDown={(event) => event.stopPropagation()}
          >
            <div style={styles.modalHeader}>
              <div>
                <h3 style={styles.modalTitle}>Add New Mold</h3>
                <p style={styles.subtitle}>Enter the basic mold information.</p>
              </div>
              <button type="button" onClick={closeForm} style={styles.closeButton}>
                ×
              </button>
            </div>

            <form onSubmit={handleAddMold}>
              <div style={styles.formGrid}>
                <FormInput label="Mold No. *" name="moldNo" value={form.moldNo} onChange={updateForm} placeholder="e.g. MOLD-006" />
                <FormInput label="Customer *" name="customer" value={form.customer} onChange={updateForm} placeholder="Enter customer name" />
                <FormInput label="Model *" name="model" value={form.model} onChange={updateForm} placeholder="Enter model name" />
                <FormInput label="Group" name="group" value={form.group} onChange={updateForm} placeholder="Enter group" />
                <FormInput label="Count" name="count" type="number" value={form.count} onChange={updateForm} />
                <div style={styles.field}>
                  <label style={styles.label}>Status</label>
                  <select name="status" value={form.status} onChange={updateForm} style={styles.formControl}>
                    <option>Active</option>
                    <option>Under Maintenance</option>
                    <option>Inactive</option>
                  </select>
                </div>
              </div>

              {error && <p style={styles.error}>{error}</p>}

              <div style={styles.formActions}>
                <button type="button" style={styles.cancelButton} onClick={closeForm}>
                  Cancel
                </button>
                <button type="submit" style={styles.primaryButton}>
                  Save Mold
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

      {selectedMold && (
        <div style={styles.backdrop} onMouseDown={() => setSelectedMold(null)}>
          <div
            style={styles.modal}
            onMouseDown={(event) => event.stopPropagation()}
          >
            <div style={styles.modalHeader}>
              <div>
                <h3 style={styles.modalTitle}>Mold Details</h3>
                <p style={styles.subtitle}>{selectedMold.moldNo}</p>
              </div>
              <button
                type="button"
                onClick={() => setSelectedMold(null)}
                style={styles.closeButton}
              >
                ×
              </button>
            </div>

            <div style={styles.detailsGrid}>
              <Detail label="Mold No." value={selectedMold.moldNo} />
              <Detail label="Customer" value={selectedMold.customer} />
              <Detail label="Model" value={selectedMold.model} />
              <Detail label="Group" value={selectedMold.group} />
              <Detail label="Count" value={selectedMold.count} />
              <div>
                <p style={styles.detailLabel}>Status</p>
                <StatusBadge status={selectedMold.status} />
              </div>
            </div>

            <div style={styles.formActions}>
              <button
                type="button"
                style={styles.primaryButton}
                onClick={() => setSelectedMold(null)}
              >
                Close
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}

function SummaryCard({ label, value }) {
  return (
    <div style={styles.summaryCard}>
      <p style={styles.summaryLabel}>{label}</p>
      <h2 style={styles.summaryValue}>{value}</h2>
    </div>
  );
}

function FormInput({ label, name, value, onChange, placeholder, type = "text" }) {
  return (
    <div style={styles.field}>
      <label style={styles.label}>{label}</label>
      <input
        name={name}
        type={type}
        min={type === "number" ? "1" : undefined}
        value={value}
        onChange={onChange}
        placeholder={placeholder}
        style={styles.formControl}
      />
    </div>
  );
}

function Detail({ label, value }) {
  return (
    <div>
      <p style={styles.detailLabel}>{label}</p>
      <strong style={styles.detailValue}>{value}</strong>
    </div>
  );
}

function StatusBadge({ status }) {
  const colors = {
    Active: { background: "#dcfce7", color: "#15803d" },
    "Under Maintenance": { background: "#fff7ed", color: "#c2410c" },
    Inactive: { background: "#f1f5f9", color: "#475569" },
  };

  return (
    <span style={{ ...styles.badge, ...colors[status] }}>
      {status}
    </span>
  );
}

