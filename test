import React, { useState } from 'react';

import Sidebar from './components/layout/Sidebar';
import Header from './components/layout/Header';
import Breadcrumb from './components/layout/Breadcrumb';
import PageHeader from './components/layout/PageHeader';

import Button from './components/common/Button';
import SearchBar from './components/common/SearchBar';
import StatusBadge from './components/common/StatusBadge';

import StatCard from './components/dashboard/StatCard';
import RecentMolds from './components/dashboard/RecentMolds';
import PendingTasks from './components/dashboard/PendingTasks';

const moldRecords = [
  {
    id: 1,
    moldCode: 'MOLD-001',
    moldName: 'Front Cover Mold',
    partName: 'Front Cover',
    machine: 'IMM-250',
    status: 'ACTIVE',
    location: 'Molding',
    updatedAt: '24 Nov 2026'
  },
  {
    id: 2,
    moldCode: 'MOLD-002',
    moldName: 'Rear Housing Mold',
    partName: 'Rear Housing',
    machine: 'IMM-350',
    status: 'UNDER_TRIAL',
    location: 'Trial Room',
    updatedAt: '23 Nov 2026'
  },
  {
    id: 3,
    moldCode: 'MOLD-003',
    moldName: 'Handle Mold',
    partName: 'Handle',
    machine: 'IMM-180',
    status: 'UNDER_MAINTENANCE',
    location: 'Maintenance',
    updatedAt: '22 Nov 2026'
  }
];

const pendingTasks = [
  {
    id: 1,
    title: 'MOLD-003 - Maintenance inspection',
    description: 'Complete the scheduled inspection',
    dueDate: 'Today',
    priority: 'High'
  },
  {
    id: 2,
    title: 'MOLD-002 - Trial approval',
    description: 'Trial result awaiting approval',
    dueDate: 'Tomorrow',
    priority: 'Medium'
  },
  {
    id: 3,
    title: 'MOLD-015 - Update mold details',
    description: 'Complete missing mold information',
    dueDate: '26 Nov 2026',
    priority: 'Low'
  }
];

function App() {
  const [activePath, setActivePath] = useState('/dashboard');
  const [search, setSearch] = useState('');
  const [menuOpen, setMenuOpen] = useState(false);

  const navigation = [
    { path: '/dashboard', label: 'Dashboard' },
    { path: '/mold-register', label: 'Mold Register' },
    { path: '/add-mold', label: 'Add New Mold' },
    { path: '/mold-history', label: 'Mold History' },
    { path: '/maintenance', label: 'Maintenance' },
    { path: '/reports', label: 'Reports' }
  ];

  const activeItem =
    navigation.find(item => item.path === activePath);

  const pageTitle = activeItem?.label || 'Dashboard';

  const filteredMolds = moldRecords.filter(mold =>
    `${mold.moldCode} ${mold.moldName} ${mold.partName}`
      .toLowerCase()
      .includes(search.toLowerCase())
  );

  const handleNavigate = path => {
    setActivePath(path);
    setSearch('');
    setMenuOpen(false);
  };

  return (
    <div className="app-shell">

      <Sidebar
        activePath={activePath}
        onNavigate={handleNavigate}
      />

      <div className="app-main">

        <Header
          onMenuClick={() => setMenuOpen(!menuOpen)}
          user={{
            name: 'Molding Admin',
            role: 'Molding Department'
          }}
        />

        <main className="page-content">

          <Breadcrumb
            items={['Home', pageTitle]}
          />

          <PageHeader
            title={pageTitle}
            subtitle={
              activePath === '/dashboard'
                ? 'Monitor mold activities and department performance.'
                : `Manage ${pageTitle.toLowerCase()} information.`
            }
            actions={
              activePath === '/dashboard' ? (
                <Button
                  variant="primary"
                  onClick={() => handleNavigate('/add-mold')}
                >
                  + Register New Mold
                </Button>
              ) : null
            }
          />

          {activePath === '/dashboard' && (
            <>
              <section className="stats-grid">

                <StatCard
                  title="Total Molds"
                  value="248"
                  icon="Package"
                  color="blue"
                  trend="+12 this month"
                />

                <StatCard
                  title="Active Molds"
                  value="186"
                  icon="CheckCircle"
                  color="green"
                  trend="Currently active"
                />

                <StatCard
                  title="Under Maintenance"
                  value="18"
                  icon="Wrench"
                  color="orange"
                  trend="Needs attention"
                />

                <StatCard
                  title="Pending Tasks"
                  value="12"
                  icon="Clock"
                  color="red"
                  trend="Awaiting action"
                />

              </section>

              <section className="dashboard-grid">

                <div className="panel dashboard-molds">
                  <div className="panel-heading">
                    <div>
                      <h3>Recent Mold Records</h3>
                      <p>Recently updated mold information</p>
                    </div>

                    <Button
                      variant="outline"
                      size="small"
                      onClick={() =>
                        handleNavigate('/mold-register')
                      }
                    >
                      View All
                    </Button>
                  </div>

                  <SearchBar
                    value={search}
                    onChange={setSearch}
                    placeholder="Search mold code or name..."
                  />

                  <div className="mold-record-list">
                    {filteredMolds.map(mold => (
                      <div className="mold-record" key={mold.id}>
                        <div className="mold-record-info">
                          <strong>{mold.moldCode}</strong>
                          <span>{mold.moldName}</span>
                          <small>{mold.machine} · {mold.location}</small>
                        </div>

                        <StatusBadge status={mold.status} />
                      </div>
                    ))}

                    {filteredMolds.length === 0 && (
                      <p className="no-records">
                        No matching mold records found.
                      </p>
                    )}
                  </div>
                </div>

                <div className="panel dashboard-tasks">
                  <PendingTasks tasks={pendingTasks} />
                </div>

              </section>
            </>
          )}

          {activePath === '/mold-register' && (
            <section className="panel">
              <div className="panel-heading">
                <div>
                  <h3>Mold Register</h3>
                  <p>All registered molding tools</p>
                </div>

                <Button
                  onClick={() => handleNavigate('/add-mold')}
                >
                  + Add Mold
                </Button>
              </div>

              <SearchBar
                value={search}
                onChange={setSearch}
                placeholder="Search mold records..."
              />

              <div className="mold-record-list">
                {filteredMolds.map(mold => (
                  <div className="mold-record" key={mold.id}>
                    <div className="mold-record-info">
                      <strong>{mold.moldCode}</strong>
                      <span>{mold.moldName}</span>
                      <small>{mold.partName} · {mold.machine}</small>
                    </div>
                    <StatusBadge status={mold.status} />
                  </div>
                ))}
              </div>
            </section>
          )}

          {activePath !== '/dashboard' &&
            activePath !== '/mold-register' && (
              <section className="panel module-placeholder">
                <h3>{pageTitle}</h3>
                <p>
                  This module will be designed using the reusable
                  MRTMS components in the next development stage.
                </p>
              </section>
            )}

        </main>
      </div>
    </div>
  );
}

export default App;



import {
  LayoutDashboard,
  Boxes,
  ClipboardList,
  Workflow,
  BarChart3,
  Users,
  Settings,
  Factory
} from 'lucide-react';

const menuGroups = [
  {
    title: 'WORKSPACE',
    items: [
      { label: 'Dashboard', path: '/dashboard', icon: LayoutDashboard },
      { label: 'Mold Register', path: '/molds', icon: Boxes },
      { label: 'Trial Management', path: '/trials', icon: ClipboardList },
      { label: 'Task & Workflow', path: '/tasks', icon: Workflow },
      { label: 'Reports', path: '/reports', icon: BarChart3 }
    ]
  },
  {
    title: 'ADMINISTRATION',
    items: [
      { label: 'Users & Roles', path: '/users', icon: Users },
      { label: 'Master Settings', path: '/settings', icon: Settings }
    ]
  }
];

export default function Sidebar({ activePath = '/dashboard', onNavigate }) {
  return (
    <aside className="sidebar">
      <div className="sidebar-brand">
        <div className="brand-logo"><Factory size={22} /></div>
        <div>
          <strong>MRTMS</strong>
          <small>Mold Tracking System</small>
        </div>
      </div>

      <div className="department-label">
        MOLDING DEPARTMENT
      </div>

      <nav className="sidebar-nav">
        {menuGroups.map(group => (
          <div key={group.title}>
            <p className="nav-heading">{group.title}</p>

            {group.items.map(item => {
              const Icon = item.icon;
              const active = activePath === item.path;

              return (
                <button
                  key={item.path}
                  className={`nav-item ${active ? 'active' : ''}`}
                  onClick={() => onNavigate?.(item.path)}
                >
                  <Icon size={18} />
                  <span>{item.label}</span>
                </button>
              );
            })}
          </div>
        ))}
      </nav>

      <div className="sidebar-footer">
        <span className="online-dot" />
        Molding Department
      </div>
    </aside>
  );
}

