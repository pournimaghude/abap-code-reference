D. components/common/StatusBadge.jsx
Used to display mold, trial and task statuses consistently.

const statusStyles = {
  NEW: 'neutral',
  PLANNED: 'info',
  UNDER_TRIAL: 'warning',
  IN_PROGRESS: 'warning',
  PENDING: 'warning',
  COMPLETED: 'success',
  APPROVED: 'success',
  ACTIVE: 'success',
  REJECTED: 'danger',
  ON_HOLD: 'danger',
  CANCELLED: 'neutral'
};

export default function StatusBadge({ status }) {
  const key = String(status || 'UNKNOWN').toUpperCase();
  const label = key.replaceAll('_', ' ');

  return (
    <span className={`status-badge badge-${statusStyles[key] || 'neutral'}`}>
      <span className="status-dot" />
      {label}
    </span>
  );
}



